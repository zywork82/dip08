// Code with integrated image generation for SceneEditor.jsx
import React, { useState, useEffect } from "react";
import { useLocation } from "react-router-dom";
import ReactFlow, {
  ReactFlowProvider,
  MiniMap,
  Controls,
  Background,
  applyNodeChanges,
} from "reactflow";
import NodeWrapper from "../components/NodeWrapper";
import "reactflow/dist/style.css";
import "../styles/SceneEditor.css";
import dagre from "dagre";

// Node types
const nodeTypesConfig = {
  process: NodeWrapper,
  decision: NodeWrapper,
  end: NodeWrapper,
};

// Dagre layout
const dagreGraph = new dagre.graphlib.Graph();
dagreGraph.setDefaultEdgeLabel(() => ({}));
const nodeWidth = 200;
const nodeHeight = 150;

const getLayoutedNodes = (nodes, edges) => {
  dagreGraph.setGraph({ rankdir: "TB", ranksep: 100 });
  nodes.forEach((node) =>
    dagreGraph.setNode(node.id, { width: nodeWidth, height: nodeHeight })
  );
  edges.forEach((edge) => dagreGraph.setEdge(edge.source, edge.target));
  dagre.layout(dagreGraph);
  return nodes.map((node) => {
    const { x, y } = dagreGraph.node(node.id);
    return { ...node, position: { x: x - nodeWidth / 2, y: y - nodeHeight / 2 } };
  });
};

const SceneEditor = () => {
  const location = useLocation();
  const flowData = location.state?.flowData;

  const [nodes, setNodes] = useState(flowData?.nodes || []);
  const [edges, setEdges] = useState(flowData?.edges || []);
  const [selectedNode, setSelectedNode] = useState(null);
  const [promptText, setPromptText] = useState("");

  // --- Backend call for image generation ---
  const generateImageForNode = async (nodeId, prompt) => {
    try {
      const res = await fetch("/api/generate-image", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: nodeId, scene: prompt }),
      });

      const data = await res.json();
      if (data.b64Image) {
        const imgUrl = `data:image/png;base64,${data.b64Image}`;
        setNodes((nds) =>
          nds.map((n) =>
            n.id === nodeId
              ? { ...n, data: { ...n.data, generatedImages: [imgUrl], imageUrl: imgUrl } }
              : n
          )
        );
      }
    } catch (err) {
      console.error("Error generating image:", err);
    }
  };

  // Handle reprompt from sidebar
  const handleReprompt = (nodeId, prompt) => {
    generateImageForNode(nodeId, prompt);
  };

  // Select image for node
  const selectImageForNode = (nodeId, imgUrl) => {
    setNodes((nds) =>
      nds.map((n) => (n.id === nodeId ? { ...n, data: { ...n.data, imageUrl: imgUrl } } : n))
    );
  };

  // Node click selection
  const onNodeClick = (_, node) => {
    setSelectedNode(node);
    setPromptText(node.data.label);
  };

  // Nodes change handler
  const onNodesChange = (changes) => setNodes((nds) => applyNodeChanges(changes, nds));

  // Initialize nodes with base64 images from backend
  useEffect(() => {
    if (!flowData) return;

    const initNodes = flowData.nodes.map((n) => {
      let imgUrl = null;
      if (n.data?.b64Image) {
        imgUrl = `data:image/png;base64,${n.data.b64Image}`;
      }
      return {
        ...n,
        data: {
          ...n.data,
          generatedImages: imgUrl ? [imgUrl] : [],
          imageUrl: imgUrl,
          onReprompt: (p) => handleReprompt(n.id, p),
        },
      };
    });

    setEdges(flowData.edges);
    setNodes(getLayoutedNodes(initNodes, flowData.edges));
  }, [flowData]);

  return (
    <div className="scene-editor-container" style={{ display: "flex", width: "100%", height: "100vh" }}>
      {/* Sidebar for selected node */}
      {selectedNode && (
        <div
          className="node-sidebar"
          style={{
            width: 300,
            padding: 20,
            background: "#f5f5f5",
            borderRight: "1px solid #ccc",
            overflowY: "auto",
          }}
        >
          <h3>{selectedNode.data.label}</h3>
          <textarea
            value={promptText}
            onChange={(e) => setPromptText(e.target.value)}
            placeholder="Refine prompt or add description"
            rows={4}
            style={{ width: "100%", marginBottom: 10 }}
          />
          <button
            style={{ width: "100%", marginBottom: 10 }}
            onClick={() => handleReprompt(selectedNode.id, promptText)}
          >
            Generate Image
          </button>

          <div style={{ display: "flex", flexWrap: "wrap" }}>
            {selectedNode.data.generatedImages?.map((imgUrl, index) => (
              <img
                key={index}
                src={imgUrl}
                alt={`Option ${index}`}
                style={{
                  width: 100,
                  marginRight: 5,
                  marginBottom: 5,
                  cursor: "pointer",
                  border: imgUrl === selectedNode.data.imageUrl ? "2px solid blue" : "1px solid gray",
                }}
                onClick={() => selectImageForNode(selectedNode.id, imgUrl)}
              />
            ))}
          </div>
        </div>
      )}

      {/* Main editor */}
      <div style={{ flex: 1 }}>
        <ReactFlowProvider>
          <ReactFlow
            nodes={nodes}
            edges={edges}
            nodeTypes={nodeTypesConfig}
            fitView
            onNodeClick={onNodeClick}
            onNodesChange={onNodesChange}
            nodesDraggable
            zoomOnScroll
            panOnDrag
            zoomOnPinch
          >
            <MiniMap />
            <Controls />
            <Background />
          </ReactFlow>
        </ReactFlowProvider>
      </div>
    </div>
  );
};

export default SceneEditor;
